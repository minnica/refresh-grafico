{
  "schemaVersion": 2,
  "universities": {
    "ulatina": {
      "requiredConfig": "src/_content/ulatina_general_config.njk",
      "importLine": "{%- import \"src/_content/ulatina_general_config.njk\" as config -%}",
      "moduleNamespace": "ulatina",
      "extract": {
        "assetBase": "https://ap-university-storage.s3.us-east-1.amazonaws.com/ulatina",
        "iconsPath": "icons",
        "assetCatalogScope": "universidad:ulatina",
        "frameworkAssets": ["icon_email_white.png", "icon_phone_white.png", "icon_wa_white.png", "logo_ulatina_white.png", "logo_ulatina_arizona.png", "logo_ulatina_maestria.png", "wa_green.jpg", "spacer.gif"],
        "mergeTags": {"nombre": "{$firstName}", "programa": "{$dataPrograma}", "fechainicioclases": "{$dataFechaInicioClases}"},
        "canonicalWhatsapp": "50640017234"
      },
      "textCheck": {"threshold": 0.6, "minWords": 5, "ignore": ["derechos reservados", "onlineulatina", "si no deseas recibir", "desuscribir", "politica de privacidad", "todos los derechos"]},
      "profiles": {
        "src/maestrias/ventas": {"layout": "base.njk", "headerConfig": "maestrias", "footerConfig": "maestrias", "isResponsive": true, "permalinkBase": "maestrias/ventas/funnel"},
        "src/maestrias/retencion": {"layout": "base_rt.njk", "headerConfig": "maestriasrt", "footerConfig": "maestrias", "isResponsive": true, "permalinkBase": "maestrias/retencion/permanencia"},
        "src/masters/vt": {"layout": "base_masters.njk", "headerConfig": "masters", "footerConfig": "maestrias", "isResponsive": true, "permalinkBase": "masters/ventas/funnel"},
        "src/masters/rt": {"layout": "base_masters_rt.njk", "headerConfig": "mastersrt", "footerConfig": "maestrias", "isResponsive": true, "permalinkBase": "masters/rt"}
      }
    },
    "unapec": {
      "requiredConfig": "src/_content/unapec_general_config.njk",
      "importLine": "{%- import \"src/_content/unapec_general_config.njk\" as config -%}",
      "moduleNamespace": "unapec",
      "extract": {
        "assetBase": "https://ap-university-storage.s3.us-east-1.amazonaws.com/unapec",
        "iconsPath": "icons",
        "assetCatalogScope": "universidad:unapec",
        "frameworkAssets": ["logo_unapec_white.png", "logo_unapec_black.png", "icon_email_black.png", "icon_phone_black.png", "icon_wa_black.png", "icon_wa_white.png"],
        "mergeTags": {"nombre": "{$firstName}", "programa": "{$dataPrograma}", "fechainicioclases": "{$dataFechaInicioClases}"},
        "canonicalWhatsapp": "18299463832"
      },
      "docx": {
        "replacements": {
          "{$dataFechaInicioClases}": "{$data\u0001FechaInicioClases}",
          "[Fecha límite de inscripción]": "{$variable\u0001fecha_limite_inscripcion}",
          "[Fecha límite de pago]": "{$variable\u0001fecha_pago}"
        }
      },
      "textCheck": {"threshold": 0.6, "minWords": 5, "ignore": ["logo unapec", "footer", "tienes dudas", "info unapeconline do", "telefono", "whatsapp", "todos los derechos"]},
      "profiles": {
        "src/diplomados/ventas": {"layout": "base_diplomados.njk", "headerConfig": "diplomadosvt", "footerConfig": "diplomados", "isResponsive": true, "permalinkBase": "diplomados/ventas/funnel"},
        "src/diplomados/retencion": {"layout": "base_diplomados_rt.njk", "headerConfig": "diplomadosrt", "footerConfig": "diplomados", "isResponsive": true, "permalinkBase": "diplomados/retencion/permanencia"},
        "src/maestrias/ventas": {"layout": "base_maestrias.njk", "headerConfig": "maestriasvt", "footerConfig": "maestrias", "isResponsive": true, "permalinkBase": "maestrias/ventas/funnel"},
        "src/maestrias/retencion": {"layout": "base_maestrias_rt.njk", "headerConfig": "maestriasrt", "footerConfig": "maestriasrt", "isResponsive": true, "permalinkBase": "maestrias/retencion/permanencia"}
      }
    }
  }
}
